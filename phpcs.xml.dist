<?xml version="1.0"?>
<ruleset name="blate">
    <!-- Files or folders to sniff -->
    <file>src</file>
    <file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/ignore/*</exclude-pattern>
	<exclude-pattern>*/blate_cache/*</exclude-pattern>
	<exclude-pattern>*/tests/snapshots/*</exclude-pattern>

    <!-- Path to our coding standard folder -->
    <rule ref="vendor/oliup/oliup-cs-php/src"/>

	<!--
		A template built-in is named after the keyword it implements, and PHP reserves those words:
		`Helpers::_if()`, `_default()`, `_range()`, ... The underscore is that convention, not a
		marker of visibility, and renaming them would rename the template functions themselves.
	-->
	<rule ref="PSR2.Methods.MethodDeclaration.Underscore">
		<exclude-pattern>*/src/Helpers/Helpers.php</exclude-pattern>
	</rule>

    <!-- You should use at least PHP 8.3 -->
	<config name="testVersion" value="8.3-"/>
</ruleset>
